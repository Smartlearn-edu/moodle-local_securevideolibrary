<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/securevideolibrary/db" VERSION="20261028" COMMENT="XMLDB file for local_securevideolibrary"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_securevideolibrary_media" COMMENT="Stores metadata and encryption credentials for transcoded videos">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Display title for the video"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Optional description or notes"/>
        <FIELD NAME="duration" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Duration in seconds"/>
        <FIELD NAME="filesize" TYPE="int" LENGTH="18" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Total size of HLS assets in bytes"/>
        <FIELD NAME="uploaderid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User ID who uploaded the video"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Course ID context if uploaded from a course"/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Context ID"/>
        <FIELD NAME="visibility" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="private" SEQUENCE="false" COMMENT="Visibility scope: private, course, sitewide"/>
        <FIELD NAME="bitrateprofile" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="single" SEQUENCE="false" COMMENT="single or multi"/>
        <FIELD NAME="compressionprofile" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="balanced" SEQUENCE="false" COMMENT="datasaver, balanced, high"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="queued" SEQUENCE="false" COMMENT="Status: queued, processing, ready, failed"/>
        <FIELD NAME="errormessage" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="ffmpeg error output if failed"/>
        <FIELD NAME="encryptionkey" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="Hex-encoded 16-byte AES-128 encryption key"/>
        <FIELD NAME="encryptioniv" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="Hex-encoded 16-byte AES-128 IV"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uploaderid_idx" UNIQUE="false" FIELDS="uploaderid"/>
        <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="visibility_idx" UNIQUE="false" FIELDS="visibility"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
